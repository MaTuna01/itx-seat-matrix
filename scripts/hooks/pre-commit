#!/usr/bin/env python3
"""커밋 전 시크릿 유출 차단 (D-33).

실 자격증명이 추적되는 파일(`.env.example`)에 들어간 사고가 **세 번** 났다.
세 번 다 커밋 전에 잡았지만 사람 눈에 의존하는 방식이라 언젠가 통과한다.

세 겹으로 막는다:
1. `.env.example`의 시크릿성 키에 값이 채워졌는가 (기본 차단 + 명시적 허용)
2. `.env`의 **실제 값**이 스테이지된 아무 파일에나 나타나는가 (파일 종류 무관)
3. 애초에 커밋되면 안 되는 파일이 스테이지됐는가 (`.env`, `*.db` 등)

2번이 핵심이다. 1번은 `.env.example`만 보지만 2번은 어디에 붙여넣든 잡는다.
시크릿을 스크립트에 적어두지 않고 실행 시점에 `.env`(gitignore됨)에서 읽는다.

**규칙 자체는 `scripts/secret_scan.py`에 있다** — CI(#21)가 같은 검사를 돌린다.
이 파일은 "스테이지된 것"을 넘겨주는 얇은 껍데기다. 새 키를 허용 목록에 넣거나
금지 경로를 늘릴 일이면 그쪽을 고쳐라.

설치: git config core.hooksPath scripts/hooks
우회(정말 필요할 때만): git commit --no-verify
"""

from __future__ import annotations

import sys
from pathlib import Path

# `scripts/`를 import 경로에 넣는다 — 훅은 `scripts/hooks/`에서 실행된다.
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

# import가 실패하면 예외가 그대로 올라가 종료 코드가 0이 아니게 되고 커밋이 막힌다.
# **막히는 쪽이 맞다** — 검사를 못 돌린 채 통과시키면 훅이 없는 것과 같다.
from secret_scan import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(["--mode", "staged"]))
