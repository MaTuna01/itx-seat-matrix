#!/usr/bin/env python3
"""커밋 전 시크릿 유출 차단 (D-33).

실 자격증명이 추적되는 파일(`.env.example`)에 들어간 사고가 **세 번** 났다.
세 번 다 커밋 전에 잡았지만 사람 눈에 의존하는 방식이라 언젠가 통과한다.

세 겹으로 막는다:
1. `.env.example`의 시크릿성 키에 값이 채워졌는가 (기본 차단 + 명시적 허용)
2. `.env`의 **실제 값**이 스테이지된 아무 파일에나 나타나는가 (파일 종류 무관)
3. 애초에 커밋되면 안 되는 파일이 스테이지됐는가 (`.env`, `*.db` 등)

2번이 핵심이다. 1번은 `.env.example`만 보지만 2번은 어디에 붙여넣든 잡는다.
시크릿을 이 스크립트에 적어두지 않고 실행 시점에 `.env`(gitignore됨)에서 읽는다.

설치: git config core.hooksPath scripts/hooks
우회(정말 필요할 때만): git commit --no-verify
"""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
ENV_EXAMPLE = ".env.example"

# `.env.example`에서 값을 가져도 되는 키 — 시크릿이 아닌 것만.
# 여기 없는 키에 값이 있으면 차단한다(기본 차단). 새 설정을 추가했는데 막히면,
# 정말 시크릿이 아닌 경우에만 이 목록에 넣어라.
PUBLIC_KEYS = {
    "DB_PATH",
    "COOKIE_SECURE",
    "SESSION_DAYS",
    "SESSION_TRANSIENT_HOURS",
    "ADAPTER",
    # Phase 3. VAPID_SUBJECT는 연락처 URI(mailto:)일 뿐이고, 발송 권한은
    # VAPID_PRIVATE_KEY가 쥔다 — 그쪽은 여기 없으므로 값이 채워지면 차단된다 (D-34)
    "VAPID_SUBJECT",
    "SCHEDULER_ENABLED",
    "SCHEDULER_INTERVAL_SECONDS",
}

# 커밋되면 안 되는 경로 (.gitignore가 이미 막지만 `git add -f`를 뚫고 들어올 수 있다)
FORBIDDEN = (
    re.compile(r"(^|/)\.env$"),
    re.compile(r"\.db$"),
    re.compile(r"^scripts/phase0_results/"),
)

# 짧은 값은 검사하지 않는다 — "false"/"30"/"mock" 같은 설정값이 코드에 흔히 나온다
MIN_SECRET_LEN = 12


def git(*args: str) -> str:
    return subprocess.run(
        ["git", *args], cwd=REPO, capture_output=True, text=True, check=True
    ).stdout


def staged_files() -> list[str]:
    out = git("diff", "--cached", "--name-only", "--diff-filter=ACMR")
    return [line for line in out.splitlines() if line]


def parse_env(text: str) -> dict[str, str]:
    env = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        env[key.strip()] = value.strip().strip("'\"")
    return env


def check_env_example(problems: list[str]) -> None:
    """`.env.example`의 시크릿성 키가 비어 있는가."""
    if ENV_EXAMPLE not in staged_files():
        return
    # 워킹트리가 아니라 **스테이지된 내용**을 본다 — 커밋되는 건 이쪽이다
    staged = git("show", f":{ENV_EXAMPLE}")
    for key, value in parse_env(staged).items():
        if value and key not in PUBLIC_KEYS:
            problems.append(
                f"{ENV_EXAMPLE}: {key} 에 값이 채워져 있다. 실제 값은 .env 에만 둬라.\n"
                f"    (시크릿이 아니라면 scripts/hooks/pre-commit 의 PUBLIC_KEYS 에 추가)"
            )


def check_real_secrets(problems: list[str]) -> None:
    """`.env`의 실제 값이 스테이지된 내용에 나타나는가 — 파일 종류를 가리지 않는다."""
    env_path = REPO / ".env"
    if not env_path.exists():
        return  # 새 클론 등 — 대조할 것이 없다
    secrets = {
        key: value
        for key, value in parse_env(env_path.read_text(encoding="utf-8")).items()
        if len(value) >= MIN_SECRET_LEN and key not in PUBLIC_KEYS
    }
    if not secrets:
        return
    diff = git("diff", "--cached")
    for key, value in secrets.items():
        if value in diff:
            problems.append(
                f".env 의 {key} 실제 값이 커밋 내용에 들어 있다. "
                f"해당 줄을 지우고 .env 에만 남겨라."
            )


def check_forbidden(problems: list[str]) -> None:
    for path in staged_files():
        for pattern in FORBIDDEN:
            if pattern.search(path):
                problems.append(f"{path}: 커밋하면 안 되는 파일이다.")
                break


def main() -> int:
    problems: list[str] = []
    check_forbidden(problems)
    check_env_example(problems)
    check_real_secrets(problems)

    if not problems:
        return 0

    print("\n✖ 커밋을 막았다 — 시크릿이 새어나갈 수 있다\n", file=sys.stderr)
    for problem in problems:
        print(f"  • {problem}", file=sys.stderr)
    print(
        "\n  정말 의도한 커밋이라면: git commit --no-verify\n",
        file=sys.stderr,
    )
    return 1


if __name__ == "__main__":
    sys.exit(main())
