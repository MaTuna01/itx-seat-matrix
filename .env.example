# 실제 값은 .env 에만 두고 커밋하지 않는다. 이 파일에는 빈 값·설명만.

# ── 앱 설정 (Phase 1) ────────────────────────────────────────────────
DB_PATH=data/itx.db
# 부트스트랩 1회만 true로 두고, 첫 계정을 만든 뒤 false로 되돌린다 (PLAN 6절, D-10)
ALLOW_SIGNUP=false
# 배포(ts.net HTTPS)에서는 true. 로컬 http 개발에서는 false
COOKIE_SECURE=false
# mock | korail2 — Phase 1은 mock만 동작한다 (korail2는 Phase 2)
ADAPTER=mock
# Fernet 대칭키 (코레일 비밀번호·디스코드 웹훅 암호화, Phase 2·3에서 사용).
# 생성: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# ── 코레일 자격증명 ──────────────────────────────────────────────────
# Phase 0 검증 스크립트(scripts/phase0_feasibility.py)가 읽는 값.
# Phase 2부터는 env가 아니라 DB의 user 행(Fernet 암호화)에 저장한다 (D-10)
# 본계정 (정기권 계정)
KORAIL_ID=
KORAIL_PW=

# 조회 전용 부계정 (있을 때만. Phase 0 step 2 검증용 — 끝내 미검증, D-22)
KORAIL_SUB_ID=
KORAIL_SUB_PW=
