# 실제 값은 .env 에만 두고 커밋하지 않는다. 이 파일에는 빈 값·설명만.

# ── 앱 설정 (Phase 1) ────────────────────────────────────────────────
DB_PATH=data/itx.db
# 배포(ts.net HTTPS)에서는 true. 로컬 http 개발에서는 false
COOKIE_SECURE=false
# 세션 수명 (D-23). "로그인 유지" 체크 시 / 미체크 시
SESSION_DAYS=30
SESSION_TRANSIENT_HOURS=12
# 가입 허용은 env가 아니라 DB에 있다 — 첫 계정(관리자)이 앱 설정 화면에서 켜고 끈다 (D-24)
# mock | korail2 — Phase 1은 mock만 동작한다 (korail2는 Phase 2)
ADAPTER=mock
# Fernet 대칭키 (코레일 비밀번호·디스코드 웹훅 암호화, Phase 2·3에서 사용).
# 생성: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# ── 웹푸시 VAPID (Phase 3, D-34) ─────────────────────────────────────
# 생성: uv run python scripts/gen_vapid.py — 출력 3줄을 .env 에 붙여넣는다.
# 비밀키가 곧 발송 권한이다. 공개키는 프론트가 GET /api/push/config 로 받아 간다(공개 무해).
# ※ 키를 바꾸면 기존 push_device 등록이 전부 무효가 된다 — 기기마다 알림을 다시 켜야 한다
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 스킴이 없으면 앱이 mailto: 를 붙여준다. py_vapid는 스킴을 필수로 요구한다
VAPID_SUBJECT=mailto:you@example.com

# ── 스케줄러 (Phase 3, PLAN 9절) ─────────────────────────────────────
# 30초 틱은 "시계 확인"일 뿐이고 코레일 조회는 next_poll_at 도래 시에만 발생한다.
# 실 API를 때리지 않고 프론트만 만질 때는 false 로 끈다 (호출 예절, CLAUDE.md 10)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30

# ── 코레일 자격증명 ──────────────────────────────────────────────────
# Phase 0 검증 스크립트(scripts/phase0_feasibility.py)가 읽는 값.
# Phase 2부터는 env가 아니라 DB의 user 행(Fernet 암호화)에 저장한다 (D-10)
# 본계정 (정기권 계정)
KORAIL_ID=
KORAIL_PW=

# 조회 전용 부계정 (있을 때만. Phase 0 step 2 검증용 — 끝내 미검증, D-22)
KORAIL_SUB_ID=
KORAIL_SUB_PW=

# ── 공공데이터포털 (Phase 2 항목 A) ──────────────────────────────────
# '한국철도공사_열차운행정보'(data.go.kr 15125762) 활용신청 후 발급되는 일반 인증키.
# Encoding/Decoding 어느 쪽을 넣어도 동작한다 (스크립트가 정규화한다).
# scripts/phase2_stops_probe.py 와 정차역 소스가 읽는다.
DATA_GO_KR_SERVICE_KEY=
